includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src
        - config
        - resources/views
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    noEnvCallsOutsideOfConfig: false
    viewDirectories:
        - resources/views
    ignoreErrors:
            - '#Unsafe usage of new static#'
            - '#Cannot cast mixed to (.*)#'
            - '#Method Devhammed\\LaravelBrickMoney\\Livewire\\Synthesizers\\MoneySynthesizer::get\(\)#'
            - '#Method Devhammed\\LaravelBrickMoney\\Livewire\\Synthesizers\\MoneySynthesizer::set\(\)#'
            - '#Method Devhammed\\LaravelBrickMoney\\Livewire\\Synthesizers\\CurrencySynthesizer::get\(\)#'
            - '#Method Devhammed\\LaravelBrickMoney\\Livewire\\Synthesizers\\CurrencySynthesizer::set\(\)#'
